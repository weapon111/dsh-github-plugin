{
  "name": "@local/github",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Connect a GitHub account so the agent and the Web UI can browse repositories, upload and download files, and deploy sites or workflows.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
