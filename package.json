{
  "name": "@weapon111/dsh-github-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Connect a GitHub account so the agent and the Web UI can browse repositories, upload and download files, and deploy sites or workflows.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapon111/dsh-github-plugin.git"
  },
  "homepage": "https://github.com/weapon111/dsh-github-plugin#readme",
  "bugs": {
    "url": "https://github.com/weapon111/dsh-github-plugin/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
